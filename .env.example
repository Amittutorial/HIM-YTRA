# ══════════════════════════════════════════════════════════════════
# HIMYATRA — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Add these variables to your Vercel Project Dashboard (Settings -> Environment Variables)
# ══════════════════════════════════════════════════════════════════

# ── 1. OWNER EMAIL & NOTIFICATION DESTINATION ──
OWNER_EMAIL=amitpatel42203@gmail.com

# ── 2. TRANSACTIONAL EMAIL VIA NODEMAILER (RECOMMENDED: GMAIL APP PASSWORD) ──
# To generate a Gmail App Password:
# 1. Open Google Account (myaccount.google.com) -> Security -> 2-Step Verification
# 2. Click "App passwords" -> Name it "HimYatra Vercel" -> Copy the 16-character password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=amitpatel42203@gmail.com
SMTP_PASS=your-16-character-gmail-app-password

# ── 3. OPTIONAL ALTERNATIVE: RESEND API (resend.com) ──
# If you prefer using Resend instead of Gmail SMTP, supply your Resend API Key:
# RESEND_API_KEY=re_123456789
# RESEND_FROM=HimYatra <onboarding@resend.dev>

# ── 4. AI CHATBOT (ANTHROPIC CLAUDE) ──
